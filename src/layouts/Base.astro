---
import { site } from '../../site.config';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.siteTitle;
const pageDesc = description ?? site.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const currentPath = Astro.url.pathname;

// 页眉左上角圆形徽标里的首字母，从姓名自动取（Yining Lu → YL）
const initials = site.name
  .split(/\s+/)
  .map((word) => word[0] ?? '')
  .join('')
  .slice(0, 2)
  .toUpperCase();

// 判断导航项是否为当前页面（用于高亮）
function isCurrent(url: string) {
  if (url.startsWith('/#')) return currentPath === '/';
  return currentPath === url;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />

    <!-- 分享到社交媒体时的预览卡片 -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Source+Sans+3:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <nav>
      <div class="nav-inner">
        <a class="nav-brand" href="/">
          <span class="nav-mark" aria-hidden="true">{initials}</span>
          <span class="nav-name">{site.name}</span>
        </a>
        <div class="nav-links">
          {
            site.nav.map((item) => (
              <a href={item.url} aria-current={isCurrent(item.url) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>

    <slot />

    <footer>
      <div class="wrap footer-inner">
        <p>© {new Date().getFullYear()} {site.name}</p>
        <p class="mono">Tsinghua University</p>
      </div>
    </footer>
  </body>
</html>
