---
import Base from '../layouts/Base.astro';
import PdfPreview from '../components/PdfPreview.astro';
import { site } from '../../site.config';
---

<Base title="CV" description="Curriculum vitae of Yining Lu.">
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Curriculum Vitae</p>
      <h1>CV</h1>
      <p>
        <a class="pill" href={site.cvFile} download>Download PDF ↓</a>
      </p>
    </div>
  </header>

  <section>
    <div class="wrap">
      <!-- 折叠时只显示第一页缩略图，点开后才加载完整 PDF -->
      <PdfPreview
        file={site.cvFile}
        label={`${site.name} — Curriculum Vitae`}
        pages={site.cvPages}
        cover={site.cvCover}
      />
    </div>
  </section>
</Base>
