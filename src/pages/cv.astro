---
import Base from '../layouts/Base.astro';
import { site } from '../../site.config';
---

<Base title="CV" description="Curriculum vitae of Yining Lu.">
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Curriculum Vitae</p>
      <h1>CV</h1>
      <p>
        <a class="pill" href={site.cvFile} download>Download PDF ↓</a>
      </p>
    </div>
  </header>

  <section>
    <div class="wrap">
      <!-- 手机浏览器大多不支持内嵌 PDF，所以下面给了下载链接兜底 -->
      <object class="pdf-frame" data={site.cvFile} type="application/pdf">
        <p class="pdf-fallback">
          Your browser cannot display PDFs inline.
          <a href={site.cvFile}>Download the CV here</a>.
        </p>
      </object>
    </div>
  </section>
</Base>
