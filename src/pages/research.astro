---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ResearchCard from '../components/ResearchCard.astro';
import { Content as Publications } from '../../content/publications.md';

const research = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Research" description="Research projects by Yining Lu.">
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Research</p>
      <h1>Research</h1>
      <p>Click any area to read the full description.</p>
    </div>
  </header>

  <section>
    <div class="wrap">
      <h2>Research Areas</h2>
      <p class="section-note">Click to expand</p>
      {research.map((entry) => <ResearchCard entry={entry} />)}
      {research.length === 0 && <p class="section-note">Coming soon.</p>}
    </div>
  </section>

  <section id="publications">
    <div class="wrap">
      <h2>Publications &amp; Presentations</h2>
      <p class="section-note">* denotes corresponding author</p>
      <div class="pubs-md">
        <Publications />
      </div>
    </div>
  </section>
</Base>
