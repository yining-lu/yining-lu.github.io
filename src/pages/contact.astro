---
import Base from '../layouts/Base.astro';
import { site } from '../../site.config';
---

<Base title="Contact" description="How to get in touch with Yining Lu.">
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Contact</h1>
    </div>
  </header>

  <section>
    <div class="wrap contact-grid">
      <img class="contact-photo" src={site.contact.photo} alt={site.name} />
      <div class="contact-lines">
        <p>
          Email me at <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </p>
        {
          site.contact.academicEmail && (
            <p>
              or at{' '}
              <a href={`mailto:${site.contact.academicEmail}`}>
                {site.contact.academicEmail}
              </a>
            </p>
          )
        }
        <p>
          Connect me on <a href={site.contact.linkedin}>LinkedIn</a>
        </p>
        {
          site.contact.researchgate && (
            <p>
              Connect me on <a href={site.contact.researchgate}>ResearchGate</a>
            </p>
          )
        }
      </div>
    </div>
  </section>
</Base>
