---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'research'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// 拼装 "作者 · 期刊 · 年份" 这行小字，缺哪项就自动跳过
const meta = [d.authors, d.venue, d.year].filter(Boolean);
---

<details class="pub">
  <summary>
    <span class="pub-toggle">+</span>
    <span>
      <span class="pub-title">{d.title}</span>
      {
        meta.length > 0 && (
          <span class="pub-meta">
            {meta.map((part, i) => (
              <>
                {i > 0 && ' · '}
                {part === d.venue ? <span class="venue">{part}</span> : part}
              </>
            ))}
          </span>
        )
      }
      <span class="pub-preview">{d.summary}</span>
      {d.image && <img class="pub-thumb" src={d.image} alt={d.title} loading="lazy" />}
    </span>
  </summary>

  <div class="pub-body">
    <div class="prose">
      <Content />
    </div>
    {
      d.links.length > 0 && (
        <div class="pub-links">
          {d.links.map((l) => (
            <a href={l.url}>{l.label}</a>
          ))}
        </div>
      )
    }
  </div>
</details>
