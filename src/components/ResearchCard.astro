---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'research'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<details class="pub">
  <summary>
    <span class="pub-toggle">+</span>
    <span class="pub-head">
      <span class="pub-title">{d.title}</span>
      {d.status && <span class="pub-status">{d.status}</span>}
      {d.citation && <span class="pub-meta">{d.citation}</span>}
      <span class="pub-preview">{d.summary}</span>
      {
        d.images.length > 0 && (
          <span class={d.images.length > 1 ? 'pub-figs pub-figs-2' : 'pub-figs'}>
            {d.images.map((src) => (
              <img class="pub-thumb" src={src} alt={d.title} loading="lazy" />
            ))}
          </span>
        )
      }
    </span>
  </summary>

  <div class="pub-body">
    <div class="prose">
      <Content />
    </div>
    {
      d.links.length > 0 && (
        <div class="pub-links">
          {d.links.map((l) => (
            <a href={l.url}>{l.label}</a>
          ))}
        </div>
      )
    }
  </div>
</details>
