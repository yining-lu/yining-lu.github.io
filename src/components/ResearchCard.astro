---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'research'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const figClass = d.images.length > 1 ? 'pub-figs pub-figs-2' : 'pub-figs';
---

<details class="pub">
  <summary>
    <span class="pub-toggle">+</span>
    <span class="pub-head">
      <span class="pub-title">{d.title}</span>
      {d.status && <span class="pub-status">{d.status}</span>}
      {d.citation && <span class="pub-meta">{d.citation}</span>}

      {/* 折叠时的配图预览，展开后由 CSS 隐藏，改由下方正文后的配图接替 */}
      {
        d.images.length > 0 && (
          <span class={`${figClass} pub-figs-peek`}>
            {d.images.map((src) => (
              <img class="pub-thumb" src={src} alt={d.title} loading="lazy" />
            ))}
          </span>
        )
      }
    </span>
  </summary>

  <div class="pub-body">
    <div class="prose">
      <Content />
    </div>

    {/* 展开后配图排在正文下面 */}
    {
      d.images.length > 0 && (
        <div class={figClass}>
          {d.images.map((src) => (
            <img class="pub-thumb" src={src} alt={d.title} loading="lazy" />
          ))}
        </div>
      )
    }

    {
      d.links.length > 0 && (
        <div class="pub-links">
          {d.links.map((l) => (
            <a href={l.url}>{l.label}</a>
          ))}
        </div>
      )
    }
  </div>
</details>
