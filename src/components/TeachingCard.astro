---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PdfPreview from './PdfPreview.astro';

interface Props {
  entry: CollectionEntry<'teaching'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const code = [d.code, d.role].filter(Boolean).join(' · ');
const slides = d.slides;
---

<div class="course">
  {code && <div class="course-code">{code}</div>}
  <h3>{d.title}</h3>
  {d.institution && <p class="pub-meta">{d.institution}</p>}
  <div class="prose">
    <Content />
  </div>

  {
    slides && (
      <PdfPreview
        file={slides.file}
        label={slides.label ?? 'Slides'}
        pages={slides.pages}
        cover={slides.cover}
        unit="slides"
      />
    )
  }
</div>
