---
// 可折叠的 PDF 预览卡片：折叠时显示封面缩略图，点开后在网页里直接翻 PDF。
// Teaching 页的课件和 CV 页都用这一个组件。
interface Props {
  // PDF 路径，例如 "/cv.pdf" 或 "/slides/dyadic-data.pdf"
  file: string;
  // 卡片标题
  label?: string;
  // 页数，会显示成 "PDF · 31 pages"
  pages?: number;
  // 封面预览图路径，不传就不显示预览
  cover?: string;
  // 页数后面的单位，课件写 "slides"，文档写 "pages"
  unit?: string;
  // 是否默认展开
  open?: boolean;
}

const {
  file,
  label = 'PDF',
  pages,
  cover,
  unit = 'pages',
  open = false,
} = Astro.props;

const meta = ['PDF', pages ? `${pages} ${unit}` : null].filter(Boolean).join(' · ');
---

<details class="pdf-card" open={open} data-file={file}>
  <summary>
    <span class="pdf-card-toggle">+</span>
    <span class="pdf-card-head">
      <span class="pdf-card-title">{label}</span>
      <span class="pdf-card-meta">{meta}</span>
      {
        cover && (
          <span class="pdf-cover-wrap">
            <img
              class="pdf-cover"
              src={cover}
              alt={`${label} — first page`}
              loading="lazy"
            />
            <span class="pdf-cover-hint">Read inline →</span>
          </span>
        )
      }
    </span>
  </summary>

  <div class="pdf-card-body">
    {/* 展开后才加载 PDF，避免首屏被几 MB 的文件拖慢 */}
    <iframe class="pdf-frame" data-src={file} title={label} loading="lazy"></iframe>
    {/* 部分手机浏览器不能内嵌 PDF，给一行小字兜底 */}
    <p class="pdf-fallback">
      Not loading? <a href={file} target="_blank" rel="noopener">Open the PDF directly ↗</a>
    </p>
  </div>
</details>

<script>
  // 手机浏览器（iOS Safari、安卓 Chrome）内嵌 PDF 只会渲染第一页，不能翻页，
  // 所以这种情况下不展开，直接用系统自带的 PDF 阅读器打开。
  const canEmbedPdf = () => {
    // 标准检测：浏览器是否自带内置 PDF 阅读器
    if (navigator.pdfViewerEnabled === false) return false;
    // 触屏为主的设备（手机 / iPad）一律当作不支持
    return !window.matchMedia('(pointer: coarse)').matches;
  };

  // 展开时才把 data-src 写进 src；默认展开的卡片在页面加载后立即填上。
  const loadFrame = (el: HTMLDetailsElement) => {
    const frame = el.querySelector<HTMLIFrameElement>('iframe[data-src]');
    if (!frame) return;
    frame.src = frame.dataset.src ?? '';
    frame.removeAttribute('data-src');
  };

  // 把整张卡片换成一个真正的链接，手机上可以长按分享 / 新标签页打开
  const toLinkCard = (el: HTMLDetailsElement, file: string) => {
    const summary = el.querySelector('summary');
    if (!summary) return;

    const link = document.createElement('a');
    link.className = 'pdf-card pdf-card-link';
    link.href = file;
    link.target = '_blank';
    link.rel = 'noopener';

    const inner = document.createElement('span');
    inner.className = 'pdf-card-inner';
    while (summary.firstChild) inner.appendChild(summary.firstChild);
    link.appendChild(inner);

    const toggle = link.querySelector('.pdf-card-toggle');
    if (toggle) toggle.textContent = '↗';
    const hint = link.querySelector('.pdf-cover-hint');
    if (hint) hint.textContent = 'Open PDF ↗';

    el.replaceWith(link);
  };

  const embeddable = canEmbedPdf();

  document.querySelectorAll<HTMLDetailsElement>('details.pdf-card').forEach((el) => {
    const file = el.dataset.file;

    if (!embeddable && file) {
      toLinkCard(el, file);
      return;
    }

    if (el.open) loadFrame(el);
    el.addEventListener('toggle', () => {
      if (el.open) loadFrame(el);
    });
  });
</script>
